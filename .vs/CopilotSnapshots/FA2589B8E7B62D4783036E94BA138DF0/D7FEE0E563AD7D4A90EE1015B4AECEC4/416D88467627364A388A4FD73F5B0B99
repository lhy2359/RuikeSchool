using UnityEngine;
using UnityEngine.UI;
using TMPro; // 如果你用的是旧版Text，把这行删掉
using System;
using System.Collections;

public class UIManager : MonoBehaviour
{
    public static UIManager Instance;

    [Header("淡入淡出设置")]
    public Image fadeMask;
    public float defaultFadeTime = 0.5f;

    [Header("确认弹窗设置")]
    public GameObject confirmPanel; // 拖入你创建的ConfirmPanel
    public TMP_Text confirmText; // 拖入ConfirmText（旧版Text就把TMP_Text改成Text）
    public Button btn_Yes; // 拖入Btn_Yes
    public Button btn_No; // 拖入Btn_No

    // 按钮点击事件的回调
    private Action onYesClick;
    private Action onNoClick;

    void Awake()
    {
        // 单例初始化
        if (Instance == null)
        {
            Instance = this;
            DontDestroyOnLoad(gameObject);
            Debug.Log("✅ UIManager单例初始化成功！");
        }
        else
        {
            Destroy(gameObject);
            return;
        }

        // 初始化淡入遮罩
        if (fadeMask != null)
        {
            fadeMask.color = new Color(fadeMask.color.r, fadeMask.color.g, fadeMask.color.b, 0);
            fadeMask.gameObject.SetActive(false);
        }
        else
        {
            Debug.LogError("❌ fadeMask未赋值！");
        }

        // 初始化弹窗按钮
        InitConfirmPanel();
    }

    // 初始化弹窗按钮事件
    void InitConfirmPanel()
    {
        if (btn_Yes != null)
        {
            btn_Yes.onClick.RemoveAllListeners();
            btn_Yes.onClick.AddListener(OnYesClicked);
        }
        if (btn_No != null)
        {
            btn_No.onClick.RemoveAllListeners();
            btn_No.onClick.AddListener(OnNoClicked);
        }

        // 启动时隐藏弹窗
        if (confirmPanel != null)
        {
            confirmPanel.SetActive(false);
        }
        else
        {
            Debug.LogError("❌ 确认弹窗未赋值！");
        }
    }

    // 对外调用：显示确认弹窗
    public void ShowConfirmPanel(string message, Action yesCallback, Action noCallback = null)
    {
        if (confirmPanel == null || confirmText == null)
        {
            Debug.LogError("❌ 弹窗组件未赋值，直接执行确认操作");
            yesCallback?.Invoke();
            return;
        }

        // 设置弹窗文本
        confirmText.text = message;
        // 保存按钮回调
        onYesClick = yesCallback;
        onNoClick = noCallback;
        // 显示弹窗
        confirmPanel.SetActive(true);
    }

    // 点击「是」
    void OnYesClicked()
    {
        confirmPanel.SetActive(false);
        onYesClick?.Invoke();
    }

    // 点击「否」
    public void OnNoClicked()
    {
        confirmPanel.SetActive(false);
        onNoClick?.Invoke();
    }

    // 屏幕淡入（透明→黑屏）
    public IEnumerator FadeIn(float fadeTime = -1)
    {
        if (fadeMask == null)
        {
            Debug.LogError("❌ fadeMask为空，无法执行淡入");
            yield break;
        }

        float time = fadeTime < 0 ? defaultFadeTime : fadeTime;
        fadeMask.gameObject.SetActive(true);
        Color color = fadeMask.color;
        color.a = 0;
        fadeMask.color = color;

        for (float t = 0; t < time; t += Time.deltaTime)
        {
            color.a = Mathf.SmoothStep(0, 1, t / time);
            fadeMask.color = color;
            yield return null;
        }

        color.a = 1;
        fadeMask.color = color;
    }

    // 屏幕淡出（黑屏→透明）
    public IEnumerator FadeOut(float fadeTime = -1)
    {
        if (fadeMask == null)
        {
            Debug.LogError("❌ fadeMask为空，无法执行淡出");
            yield break;
        }

        float time = fadeTime < 0 ? defaultFadeTime : fadeTime;
        Color color = fadeMask.color;
        color.a = 1;
        fadeMask.color = color;

        for (float t = 0; t < time; t += Time.deltaTime)
        {
            color.a = Mathf.SmoothStep(1, 0, t / time);
            fadeMask.color = color;
            yield return null;
        }

        color.a = 0;
        fadeMask.color = color;
        fadeMask.gameObject.SetActive(false);
    }
}